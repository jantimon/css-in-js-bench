{
  "name": "css-in-js-bench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "setup:wpd": "node scripts/setup-wpd.mjs",
    "gen": "node ./scripts/run-gen.mjs",
    "gen:samples": "node ./gen.ts",
    "gen:wpd": "node ./scripts/run-wpd.mjs",
    "gen:wpd:lane": "node ./gen-wpd.ts",
    "report": "node --import tsx ./report.tsx",
    "verify": "node ./verify.ts",
    "dev": "vite",
    "lint": "node ./report/lint.ts",
    "test:wpd": "node --test ./report/wpd-results.test.ts ./scripts/run-wpd.test.mjs"
  },
  "//deps": "The gen/report toolchain + measurement harness deps (this is the workspace root; the lanes under techs/* declare their own styling deps).",
  "devDependencies": {
    "@jantimon/web-performance-debugger": "1.3.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autocannon": "^8.0.0",
    "postcss": "^8.5.19",
    "prettier": "^3.6.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shiki": "^3.23.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "vite": "^8.0.10"
  }
}
