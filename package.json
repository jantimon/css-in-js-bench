{
  "name": "css-in-js-bench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "setup:wpd": "node scripts/setup-wpd.mjs",
    "gen:samples": "node ./gen.ts",
    "gen:wpd": "node ./scripts/run-wpd.mjs",
    "gen:wpd:lane": "node ./gen-wpd.ts",
    "build": "node ./scripts/build.ts",
    "report": "node --import tsx ./report.tsx",
    "verify": "node ./verify.ts",
    "dev": "vite",
    "lint": "node ./report/lint.ts",
    "test:http": "node --test --test-concurrency=1 ./scripts/http-*.test.mjs ./report/http-results.test.ts",
    "test:wpd": "node --test ./report/wpd-results.test.ts ./scripts/run-wpd.test.mjs ./scripts/wpd-query.test.ts",
    "test:interaction": "node --test ./report/interaction.test.ts ./scripts/interaction.test.mjs",
    "test:browser": "node --test --test-concurrency=1 ./scripts/browser-styles.test.ts ./scripts/browser-validation.test.mjs ./scripts/browser-styles-browser.test.ts ./scripts/hydration-handoff.test.mjs"
  },
  "//deps": "The gen/report toolchain + measurement harness deps (this is the workspace root; the lanes under techs/* declare their own styling deps).",
  "devDependencies": {
    "@jantimon/web-performance-debugger": "1.5.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "autocannon": "^9.0.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.8"
  }
}
