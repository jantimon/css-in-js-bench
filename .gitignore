# Generated report output (rebuilt by `pnpm report` — CI regenerates these on deploy).
# result/ IS committed: it holds the raw measurement samples the report is derived from.
BENCHMARK.html
BENCHMARK.md
BENCHMARK.zip
/assets/
# Scratch output inside result/ (only the samples + screenshots are tracked).
result/_prev/
result/_*.log
result/verify/
# Optional vendored tooling/source trees (created by setup scripts).
vendor/
# wpd's latest-pointer dir + scratch recordings (recordings/.wpd-last.json).
recordings/
# Experimental all-WPD comparison path. The canonical report uses gen.ts's
# render-timing measurement; keep this local spike and its raw data out of commits.
gen-wpd.ts
scripts/wpd/bench-flow.mjs
scripts/wpd/node-ssr-entry.mjs
result/measurement-wpd-*.json
# Per-tech build output.
node_modules/
.pnpm-store/
techs/*/dist/
techs/*/dist-*/
# Panda/StyleX codegen output (regenerated by each lane's build).
techs/*/styled-system/
techs/*/panda.css
.swc/
.DS_Store
